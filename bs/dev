#!/usr/bin/env node
// Watch mode — rebuilds JS and CSS on any source change, serves from project root

import * as esbuild from "esbuild";
import { createServer } from "http";
import { createReadStream, existsSync, readFileSync } from "fs";
import { extname, join } from "path";
import { createHash } from "crypto";

const PORT = Number(process.env.PORT ?? 3000);

let buildCount = 0;

// Hash the JS bundle after each rebuild and log the build number.
// Vendor files are included because they are bundled via the alias map.
function buildHashPlugin() {
  return {
    name: "build-hash",
    setup(build) {
      build.onEnd(result => {
        if (result.errors.length > 0) return;
        buildCount++;
        const bundle = readFileSync("dist/js/app.js");
        const hash   = createHash("sha256").update(bundle).digest("hex").slice(0, 8);
        console.log(`build #${buildCount}  v${hash}`);
      });
    },
  };
}

const MIME = {
  ".html": "text/html",
  ".js":   "application/javascript",
  ".css":  "text/css",
  ".json": "application/json",
  ".svg":  "image/svg+xml",
  ".png":  "image/png",
  ".webmanifest": "application/manifest+json",
};

function serve(port) {
  const server = createServer((req, res) => {
    const url  = req.url ?? "/";
    const path = url === "/" ? "/index.html" : url;
    const file = join(".", path);

    if (!existsSync(file)) {
      res.writeHead(404);
      res.end("not found");
      return;
    }

    res.writeHead(200, { "Content-Type": MIME[extname(file)] ?? "application/octet-stream" });
    createReadStream(file).pipe(res);
  });

  server.on("error", err => {
    if (err.code === "EADDRINUSE") {
      serve(port + 1);
    } else {
      throw err;
    }
  });

  server.listen(port, () => {
    console.log(`watching…  http://localhost:${port}`);
  });
}

const shared = {
  bundle: true,
  platform: "browser",
  target: "es2022",
  sourcemap: true,
  nodePaths: [new URL("../node_modules", import.meta.url).pathname],
  alias: {
    "cmstr":           "/home/rg/Code/cmstr/clients/ts/mod.ts",
    "cmstr/hashing":   "/home/rg/Code/cmstr/src/core/hashing.ts",
    "cmstr/idb":       "/home/rg/Code/cmstr/src/storage/idb/index.ts",
    "cmstr/scheduler": "/home/rg/Code/cmstr/src/storage/idb/scheduler.ts",
    "cmstr/node":      "/home/rg/Code/cmstr/src/core/node.ts",
    "cmstr/sync":      "/home/rg/Code/cmstr/src/core/sync.ts",
    "cmstr/backend":   "/home/rg/Code/cmstr/src/storage/backend.ts",
  },
  tsconfig: "tsconfig.json",
};

const [jsCtx, cssCtx] = await Promise.all([
  esbuild.context({
    ...shared,
    entryPoints: ["ts/index.ts"],
    format: "esm",
    outfile: "dist/js/app.js",
    plugins: [buildHashPlugin()],
  }),
  esbuild.context({
    ...shared,
    entryPoints: ["css/app.css"],
    outfile: "dist/css/app.css",
  }),
]);

await Promise.all([jsCtx.watch(), cssCtx.watch()]);
serve(PORT);
