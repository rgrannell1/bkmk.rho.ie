#!/usr/bin/env node
// Bundle with content-hashed filenames, write dist/index.html and dist/sw.js.

import * as esbuild from "esbuild";
import { readdirSync, rmSync, writeFileSync, existsSync } from "fs";
import { join } from "path";
import { createHash } from "crypto";

const ALIAS = {
  "cmstr":         "./vendor/cmstr/mod.ts",
  "cmstr/hashing": "./vendor/cmstr/hashing.ts",
};

function cleanStale() {
  const targets = [
    ["dist/js",  /^app-.+\.(js|js\.map)$/],
    ["dist/css", /^app-.+\.css$/],
  ];
  for (const [dir, pattern] of targets) {
    if (!existsSync(dir)) continue;
    for (const file of readdirSync(dir)) {
      if (pattern.test(file)) rmSync(join(dir, file));
    }
  }
}

function findOutput(meta, entryPoint) {
  for (const [outPath, info] of Object.entries(meta.outputs)) {
    if (info.entryPoint === entryPoint && !outPath.endsWith(".map")) {
      return outPath.replace(/^dist\//, "");
    }
  }
  throw new Error(`No output found for entry: ${entryPoint}`);
}

function indexHtml(jsPath, cssPath, buildHash) {
  return `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#070d1a">
  <title>bkmk</title>
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icons/icon.svg">
  <link rel="stylesheet" href="/${cssPath}">
</head>
<body>
  <div id="app" data-build="v${buildHash}"></div>
  <script type="module" src="/${jsPath}"></script>
  <script>
    if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
      navigator.serviceWorker.register('/sw.js')
    }
  </script>
</body>
</html>
`;
}

function swJs(jsPath, cssPath, cacheVersion) {
  return `// Service worker — network-first; cache is offline fallback only.

const CACHE = '${cacheVersion}'

const APP_SHELL = [
  '/',
  '/${jsPath}',
  '/${cssPath}',
  '/manifest.json',
  '/icons/icon.svg',
]

self.addEventListener('install', evt => {
  evt.waitUntil(
    caches.open(CACHE).then(cache => cache.addAll(APP_SHELL))
  )
  self.skipWaiting()
})

self.addEventListener('activate', evt => {
  evt.waitUntil(
    caches.keys().then(keys =>
      Promise.all(keys.filter(key => key !== CACHE).map(key => caches.delete(key)))
    )
  )
  self.clients.claim()
})

self.addEventListener('fetch', evt => {
  if (evt.request.method !== 'GET') return
  evt.respondWith(
    fetch(evt.request)
      .then(response => {
        if (response.ok) {
          const clone = response.clone()
          caches.open(CACHE).then(cache => cache.put(evt.request, clone))
        }
        return response
      })
      .catch(() => caches.match(evt.request))
  )
})
`;
}

async function build() {
  cleanStale();

  const [jsResult, cssResult] = await Promise.all([
    esbuild.build({
      entryPoints: ["ts/index.ts"],
      bundle: true,
      outdir: "dist",
      entryNames: "js/app-[hash]",
      format: "esm",
      minify: true,
      sourcemap: true,
      platform: "browser",
      target: "es2022",
      alias: ALIAS,
      tsconfig: "tsconfig.json",
      metafile: true,
    }),
    esbuild.build({
      entryPoints: ["css/app.css"],
      bundle: true,
      outdir: "dist",
      entryNames: "css/app-[hash]",
      minify: true,
      metafile: true,
    }),
  ]);

  const jsPath  = findOutput(jsResult.metafile,  "ts/index.ts");
  const cssPath = findOutput(cssResult.metafile, "css/app.css");

  const jsHashMatch  = jsPath.match(/-([A-Z0-9]+)\.js$/i);
  const cssHashMatch = cssPath.match(/-([A-Z0-9]+)\.css$/i);
  const jsHash  = jsHashMatch  ? jsHashMatch[1]  : "unknown";
  const cssHash = cssHashMatch ? cssHashMatch[1] : "unknown";
  const buildHash    = createHash("sha256").update(jsHash + cssHash).digest("hex").slice(0, 8).toLowerCase();
  const cacheVersion = `bkmk-${buildHash}`;

  writeFileSync(join("dist", "index.html"), indexHtml(jsPath, cssPath, buildHash));
  writeFileSync(join("dist", "sw.js"),      swJs(jsPath, cssPath, cacheVersion));

  console.log(`  js   ${jsPath}`);
  console.log(`  css  ${cssPath}`);
  console.log(`  sw   cache: ${cacheVersion}`);
  console.log("build done");
}

build();
